{
  "name": "smart-ledger-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-04-13",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "OPENAI_MODEL": "gpt-5",
    "ALLOWED_ORIGIN": "https://123321step.github.io"
  },
  "kv_namespaces": [
    {
      "binding": "LEDGER_STORE",
      "id": "replace-with-your-kv-id"
    }
  ]
}
